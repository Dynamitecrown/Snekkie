# --- Python (the 1.x releases) ---------------------------------------------
.venv/
__pycache__/
*.py[cod]

# --- Build artifacts ------------------------------------------------------
/target/
build/
dist/
*.spec

# --- Editors --------------------------------------------------------------
.vscode/
.idea/
*.swp
*~

# --- OS -------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# --- Things that must never leave your machine ----------------------------
# Session logs capture everything that scrolled past, including any password
# you typed at a console prompt before the far end started echoing asterisks.
*.log
logs/
session*.txt

# Saved sessions normally live in %APPDATA%\snekkie, but if you ever point the
# store at the project folder for testing, keep it out of the history.
sessions.json

# Keys and host data. Belt and braces -- these should never be in here at all.
*.pem
*.ppk
id_rsa*
id_ed25519*
known_hosts
